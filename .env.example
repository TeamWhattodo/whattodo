# LLM Provider ("openai" | "anthropic")
LLM_PROVIDER=openai

# API Keys — 사용하는 provider 키만 입력
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models — 기본값 그대로 써도 무방
FAST_MODEL=gpt-4o-mini
SMART_MODEL=gpt-4o

# Google (Gmail / Calendar OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=

# Jira
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_BASE_URL=
