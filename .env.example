# LLM Provider ("openai" | "anthropic")
LLM_PROVIDER=openai

# API Keys — 사용하는 provider 키만 입력
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models — 기본값 그대로 써도 무방
FAST_MODEL=gpt-4o-mini
SMART_MODEL=gpt-4o

# Google (Gmail / Calendar OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=T0AHHGY43LP
SLACK_BOT_USER_ID=U0B6CKA5K7A

# Jira
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_BASE_URL=

# LangSmith (트레이싱 / 옵션)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=whattodo

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
JWT_SECRET=
JWT_EXPIRE_DAYS=7
COOKIE_SECURE=false
jwt_access_secret=
jwt_refresh_secret=
OAUTH_ENCRYPTION_KEY=